def _xdg_config_path() -> str:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser(
        "~/.config")
    return os.path.join(base, APP_NAME, "config.toml")


def load_config(path: str) -> dict:
    """Built-in defaults overlaid by the TOML at `path` (if it exists).
    Returns a fresh dict; does NOT apply CLI flags (that's done after
    parsing, so the CLI always wins). Unknown top-level keys are kept
    (harmless) but a malformed file raises with a clear message."""
    cfg = dict(DEFAULTS)
    cfg["sources"] = [dict(s) for s in DEFAULTS["sources"]]
    cfg["profiles"] = {}
    if path and os.path.exists(path):
        with open(path, "rb") as f:
            data = tomllib.load(f)
        # [[source]] arrays-of-tables land under the "source" key.
        srcs = data.pop("source", None)
        # [profiles.<name>] tables land under the "profiles" key. Each
        # may carry scalar overlays and an array-of-tables `source`
        # (its own [[profiles.<name>.source]]). Normalize that nested
        # `source` key into a flat "sources" list per profile.
        prof_data = data.pop("profiles", None)
        if prof_data is not None:
            for name, pdef in prof_data.items():
                pdict = dict(pdef)
                psrcs = pdict.pop("source", None)
                if psrcs is not None:
                    pdict["sources"] = [dict(s) for s in psrcs]
                cfg["profiles"][name] = pdict
        for k, v in data.items():
            if k == "tts" and isinstance(v, dict):
                # Deep-merge the [tts] table: keep DEFAULTS["tts"] keys
                # the file omits, and merge [tts.lang.<code>] overlays
                # rather than replacing the whole lang map.
                base = dict(cfg["tts"])
                base_lang = dict(base.get("lang", {}))
                for tk, tv in v.items():
                    if tk == "lang" and isinstance(tv, dict):
                        for code, ldef in tv.items():
                            base_lang[code] = dict(ldef)
                        base["lang"] = base_lang
                    else:
                        base[tk] = tv
                cfg["tts"] = base
            else:
                cfg[k] = v
        if srcs is not None:
            cfg["sources"] = [dict(s) for s in srcs]
    # Names that came from the config file (a config profile of the same
    # name as a built-in REPLACES it, and should be reported as config
    # in --list-profiles).
    cfg["_config_profile_names"] = set(cfg["profiles"])
    # Merge built-in profiles UNDER config profiles (config wins: a
    # config profile of the same name fully replaces the built-in).
    merged = {}
    for name, pdef in BUILTIN_PROFILES.items():
        merged[name] = dict(pdef)
        if "sources" in pdef:
            merged[name]["sources"] = [dict(s) for s in pdef["sources"]]
    merged.update(cfg["profiles"])
    cfg["profiles"] = merged
    return cfg


