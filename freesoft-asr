# ---------------- fastText language id (lid.176) — D8 ----------------
# Detects each completed sentence's source language ONCE (at the
# sentence boundary, where translation fires — not per-delta). Used only
# when a stream's src_lang is unset. Degrades gracefully: if fastText or
# its model is missing, falls back to DEFAULT_SRC_LANG with one warning.
_FT_MODEL = None
_FT_AVAILABLE = False
_FT_WARNED = False
# Candidate model locations (lid.176.ftz is ~917 KB). Override with the
# FASTTEXT_LID_MODEL env var.
_FT_MODEL_PATHS = [
    os.environ.get("FASTTEXT_LID_MODEL", ""),
    os.path.expanduser("~/asr/models/lid.176.ftz"),
    os.path.expanduser("~/asr/models/lid.176.bin"),
    os.path.expanduser("~/.cache/fasttext/lid.176.ftz"),
]


def _load_fasttext():
    """Best-effort load of fastText lid.176. Sets _FT_MODEL / _FT_
    AVAILABLE. Tries the `fasttext` package against a local .ftz/.bin,
    then the `fasttext_langdetect`/`ftlangdetect` wrapper (which bundles
    its own model download). Never raises."""
    global _FT_MODEL, _FT_AVAILABLE
    # 1. raw fasttext + a local model file
    try:
        import fasttext
        for p in _FT_MODEL_PATHS:
            if p and os.path.exists(p):
                _FT_MODEL = fasttext.load_model(p)
                _FT_AVAILABLE = True
                return
    except Exception:
        pass
    # 2. ftlangdetect wrapper (bundles model download on first use)
    try:
        from ftlangdetect import detect as _ftdetect

        class _Wrap:
            def detect(self, text):
                r = _ftdetect(text=text.replace("\n", " "), low_memory=False)
                return r.get("lang")
        _FT_MODEL = _Wrap()
        _FT_AVAILABLE = True
        return
    except Exception:
        pass
    _FT_AVAILABLE = False


def detect_src_lang(text: str, pinned: str | None) -> str:
    """Resolve the NLLB src_lang for one sentence. If `pinned` is set
    (stream/global src_lang override), use it (detection off). Else run
    fastText once; map its ISO code to a FLORES-200 code. On any failure
    (no fastText, unmapped code, empty text) fall back to
    DEFAULT_SRC_LANG with a one-time stderr warning (mirrors how silero
    degrades)."""
    global _FT_WARNED
    if pinned:
        return pinned
    if _FT_AVAILABLE and _FT_MODEL is not None and text.strip():
        try:
            if hasattr(_FT_MODEL, "predict"):     # raw fasttext model
                labels, _ = _FT_MODEL.predict(text.replace("\n", " "), k=1)
                iso = labels[0].replace("__label__", "")
            else:                                  # wrapper
                iso = _FT_MODEL.detect(text)
            code = FT_TO_NLLB.get(iso)
            if code:
                return code
        except Exception:
            pass
    if not _FT_WARNED:
        _FT_WARNED = True
        print(f"WARNING: fastText language id unavailable / inconclusive; "
              f"falling back to src_lang={DEFAULT_SRC_LANG}. Install "
              f"fasttext-wheel (or fasttext-langdetect) and/or set "
              f"FASTTEXT_LID_MODEL to lid.176.ftz to enable per-sentence "
              f"detection.", file=sys.stderr, flush=True)
    return DEFAULT_SRC_LANG


