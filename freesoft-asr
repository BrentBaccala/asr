def _build_sources():
    """Resolve the active source list from --source / the selected
    profile / config / the default-monitor fallback, applying per-stream
    language inheritance and auto-assigning accent colours + a SOLO label
    when there's a single unlabelled source.

    Returns a list of dicts with keys: target, label, accent, src_lang,
    tgt_langs. The list order is the render/iteration order."""
    # 1. pick the raw source list (precedence: --source (CLI) > selected
    #    profile's sources > top-level config [[source]] > default-monitor
    #    fallback).
    if args.sources:
        raw = []
        for spec in args.sources:
            if "=" in spec:
                tgt, lbl = spec.split("=", 1)
            else:
                tgt, lbl = spec, None
            raw.append({"target": tgt, "label": lbl})
    elif PROFILE_SOURCES:
        raw = [dict(s) for s in PROFILE_SOURCES]
    elif CONFIG["sources"]:
        raw = [dict(s) for s in CONFIG["sources"]]
    else:
        # D2 default: a single stream capturing the default sink monitor.
        raw = [{"target": MONITOR, "label": None}]

    single_unlabelled = (len(raw) == 1 and not raw[0].get("label"))
    out = []
    for i, s in enumerate(raw):
        tgt = s.get("target", MONITOR)
        lbl = s.get("label")
        if not lbl:
            lbl = SOLO if single_unlabelled else f"S{i + 1}"
        accent = s.get("accent") or ACCENT_PALETTE[i % len(ACCENT_PALETTE)]
        src_lang = s.get("src_lang") or GLOBAL_SRC_LANG
        tgt_langs = _normalize_lang_list(
            s["tgt_langs"] if "tgt_langs" in s and s["tgt_langs"] is not None
            else GLOBAL_TGT_LANGS)
        if args.no_translate:
            tgt_langs = []
        # `speak`: list of FLORES-200 codes to vocalize for this source.
        # Each MUST also be in this source's effective tgt_langs (you can
        # only speak a language you're translating into) — warn + drop a
        # speak code that isn't. --no-translate clears speak too (nothing
        # to vocalize). Absent/empty => no TTS (unchanged behaviour).
        speak = _normalize_lang_list(s.get("speak"))
        if args.no_translate:
            speak = []
        kept = []
        for code in speak:
            if code in tgt_langs:
                kept.append(code)
            else:
                print(f"{APP_NAME}: source {lbl!r}: speak code {code!r} is "
                      f"not in this source's tgt_langs {tgt_langs}; ignoring "
                      f"(you can only speak a language you translate into).",
                      file=sys.stderr)
        out.append({"target": tgt, "label": lbl, "accent": accent,
                    "src_lang": src_lang, "tgt_langs": tgt_langs,
                    "speak": kept})
    return out


