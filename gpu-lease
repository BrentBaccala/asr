#!/usr/bin/env bash
# gpu-lease — GPU arbitration on pony (RTX 3090, 24 GB)
#
# The card cannot hold every tenant at once, but it is a *divisible* resource
# and the tenants are not all the same size.  gpu-lease therefore has two modes:
#
#   EXCLUSIVE  (claim / release)   — "I need the whole card."
#       For ollama qwen3.6:27b (~23.3 GB).  Stops voxtral.service, verifies its
#       VRAM is actually freed, and blocks every other tenant until released.
#
#   SHARED     (suppress / unsuppress) — "I need N MiB alongside others."
#       Refcounted and VRAM-gated.  Several small tenants (the whisperx caption
#       pipeline ~5.4 GB, the aikedit SAM 2 tracking pass ~9 GB) coexist on the
#       one card.  voxtral.service is stopped when the suppressor refcount goes
#       0 -> 1 and restarted when it returns to 0, so ASR downtime is shared
#       across the whole set rather than paid per tenant.
#
# Why both: voxtral (vLLM, cosine@ user unit) reserves ~15.2 GB whenever it is
# up, which leaves too little for anything else.  Suppressing it frees ~22.5 GB
# — enough for a tracking pass and a transcription concurrently.  Before shared
# mode existed, a caption job simply queued behind an unrelated tracking job
# while 12-14 GB sat idle (measured 2026-09-01/02: six consecutive failures).
#
# Guardrails:
#   * claim/suppress refuse while an interpretation/transcription request is
#     mid-flight (vllm:num_requests_running > 0) unless --force.  Every live
#     interpret-web session streams through vLLM on :8000, so this single
#     metric is the unified "is anyone talking" signal.
#   * a suppress is granted only if  sum(suppressors) + N + RESERVE <= CAPACITY.
#   * claim refuses (or --wait queues) while any suppressor is live, so qwen
#     can never land on top of a shared set.
#   * expires_at is AUTHORITATIVE.  Every gate treats an expired lease or
#     suppressor as free and reaps it, so a crashed client self-heals on the
#     next request rather than waiting for a timer.
#   * a systemd --user safety timer per holder is a *backstop* only: when it
#     fires it re-checks expires_at and re-arms itself if the lease is not
#     actually expired yet (`systemctl --user daemon-reload` silently re-bases
#     monotonic timers, so the timer's own idea of "now + ttl" cannot be
#     trusted — verified 2026-09-02).
#
# Runs as the pony `claude` user (passwordless sudo drives cosine's user
# units). Deployed from github.com/BrentBaccala/asr: edit on samsung, push,
# `git -C ~/asr pull` on pony; symlinked onto PATH at /usr/local/bin/gpu-lease.
#
# State files: $XDG_RUNTIME_DIR/gpu-lease.json      exclusive lease (legacy fmt)
#              $XDG_RUNTIME_DIR/gpu-lease.shared.json  suppressor table
# — tmpfs paths cleared on reboot.  That is deliberate: a reboot autostarts
# voxtral fresh (linger is enabled on cosine), so no stale state may survive.

set -uo pipefail

# Make the tool self-contained regardless of the (login vs non-login vs
# systemd-service) PATH it is invoked with.  GPU_LEASE_BIN_OVERRIDE prepends a
# directory ahead of the system ones — used by the test harness to stub
# nvidia-smi / systemctl / sudo / curl; never set in production.
export PATH="${GPU_LEASE_BIN_OVERRIDE:+$GPU_LEASE_BIN_OVERRIDE:}/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# systemctl --user / systemd-run --user need these when we are invoked from a
# non-login ssh (which does not export them).
UID_N="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID_N}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

# ---- config (URLs overridable via env, mainly for testing the gates) ----
VOXTRAL_HEALTH="${GPU_LEASE_HEALTH_URL:-http://localhost:8000/health}"
VOXTRAL_METRICS="${GPU_LEASE_METRICS_URL:-http://localhost:8000/metrics}"
QWEN_MODEL="qwen3.6:27b"
LOCK="$XDG_RUNTIME_DIR/gpu-lease.json"
SHARED="$XDG_RUNTIME_DIR/gpu-lease.shared.json"
RELLOCK="$XDG_RUNTIME_DIR/gpu-lease.rel.lock"
STATELOCK="$XDG_RUNTIME_DIR/gpu-lease.state.lock"
TIMER_UNIT="gpu-lease-autorelease"
SUP_TIMER_PREFIX="gpu-lease-unsuppress"
DEFAULT_TTL="2h"
DEFAULT_SUP_TTL="3h"

# VRAM budget for shared mode, MiB.  CAPACITY is the card; RESERVE is what is
# NOT available to suppressors and covers (a) the always-resident untracked
# tenants — the cosine TTS worker ~1.6 GB and ollama bge-m3 ~1.7 GB, which hold
# no lease — and (b) allocator headroom, since a CUDA process's peak transient
# is not its steady-state footprint.
#
# Sizing evidence (2026-09-02, task 487; see
# ~/project/reports/gpu-lease-shared-mode.md):
#   chunktrack.py SAM 2 pass  peak 9128 MiB   (p99 9105, steady ~8.6 GB)
#   whisperx caption pipeline peak 5394 MiB
#   TTS german_24l            1574 MiB   (untracked)
#   ollama bge-m3             1680 MiB   (untracked, transient)
# 9128 + 5394 = 14522 declared; 24576 - 14522 = 10054 left for RESERVE, so a
# 5 GB RESERVE keeps ~5 GB of true slack above the two-tenant worst case.
CAPACITY_MB="${GPU_LEASE_CAPACITY_MB:-}"
RESERVE_MB="${GPU_LEASE_RESERVE_MB:-5120}"

HEALTH_TIMEOUT=300      # s to wait for voxtral /health=200 after release.
                        # Voxtral-Mini-4B (~9 GB) cold-loads from /mnt/models
                        # (~160 MB/s) since the 2026-07-24 model migration, so a
                        # cache-cold reload runs ~120-140 s (was ~60-95 s off the
                        # root SSD). 300 s leaves generous margin.
VRAM_FREE_TIMEOUT=60    # s to wait for EngineCore VRAM to actually drop
SELF="$(readlink -f "$0")"

# ---- logging ----
log()  { printf '[gpu-lease] %s\n' "$*" >&2; }
warn() { printf '[gpu-lease] WARNING: %s\n' "$*" >&2; }
die()  { printf '[gpu-lease] ERROR: %s\n' "$*" >&2; exit 1; }
now()  { date +%s; }

# ---- voxtral (cosine@ user unit, driven via sudo) ----
voxtral_active() { sudo systemctl --user -M cosine@ is-active voxtral.service 2>/dev/null || true; }
voxtral_stop()   { sudo systemctl --user -M cosine@ stop  voxtral.service; }
voxtral_start()  { sudo systemctl --user -M cosine@ start voxtral.service; }

health_code() { local c; c="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$VOXTRAL_HEALTH" 2>/dev/null)"; echo "${c:-000}"; }

# ---- GPU inspection ----
gpu_apps()     { nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader 2>/dev/null; }
vllm_on_gpu()  { gpu_apps | grep -q 'VLLM::EngineCore'; }
gpu_mem_line() { nvidia-smi --query-gpu=memory.total,memory.used,memory.free --format=csv,noheader 2>/dev/null; }
gpu_free_mb()  { nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' '; }
capacity_mb() {
    if [ -n "$CAPACITY_MB" ]; then echo "$CAPACITY_MB"; return; fi
    local t; t="$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')"
    case "$t" in ''|*[!0-9]*) echo 24576 ;; *) echo "$t" ;; esac
}

# Idleness: echoes an integer request count, or -1 if unknown.
#   voxtral down     -> 0  (nothing can be running)
#   metrics readable -> vllm:num_requests_running (rounded)
#   voxtral up but metrics unreadable -> -1 (unknown; treat as busy)
requests_running() {
    if [ "$(voxtral_active)" != "active" ]; then echo 0; return; fi
    local body; body="$(curl -s --max-time 5 "$VOXTRAL_METRICS" 2>/dev/null)"
    [ -n "$body" ] || { echo -1; return; }
    printf '%s\n' "$body" | awk '
        /^vllm:num_requests_running/ { v=$2; f=1 }
        END { if (f) printf "%d\n", (v+0.5); else print -1 }'
}

# ---- ttl helpers ----
ttl_seconds() {
    local t="$1"
    case "$t" in
        *h)   echo $(( ${t%h}   * 3600 )) ;;
        *min) echo $(( ${t%min} * 60 ))   ;;
        *m)   echo $(( ${t%m}   * 60 ))   ;;
        *s)   echo "${t%s}" ;;
        *)    echo "$t" ;;
    esac
}

# ================= state: exclusive lease (legacy file format) =================
#
# The exclusive lock's on-disk shape is UNCHANGED from the pre-shared-mode
# version, so a lock written by the old script is read correctly here, and the
# armed safety timer (which invokes this script by absolute path) can release
# it.  Readers tolerate a missing expires_at / expires_at_h / ttl.
lock_field() { [ -f "$LOCK" ] && jq -r ".$1 // empty" "$LOCK" 2>/dev/null || true; }
lock_age() {
    local c; c="$(lock_field claimed_at)"; [ -n "$c" ] || { echo "?"; return; }
    local age=$(( $(now) - c ))
    printf '%dm%02ds' $(( age / 60 )) $(( age % 60 ))
}

# Echo the lease's absolute expiry epoch, or "" if it cannot be determined.
# Handles three shapes: modern (expires_at present), legacy-with-ttl
# (claimed_at + ttl), and unparseable (empty -> never expires).
lock_expiry() {
    local e; e="$(lock_field expires_at)"
    case "$e" in ''|*[!0-9]*) ;; *) echo "$e"; return ;; esac
    local c t; c="$(lock_field claimed_at)"; t="$(lock_field ttl)"
    if [ -n "$c" ] && [ -n "$t" ]; then
        local s; s="$(ttl_seconds "$t")"
        case "$s" in ''|*[!0-9]*) ;; *) echo $(( c + s )); return ;; esac
    fi
    echo ""
}

write_lock() {
    local label="$1" ttl="$2" n exp
    n="$(now)"; exp=$(( n + $(ttl_seconds "$ttl") ))
    jq -n \
        --arg holder "$(whoami)@$(hostname)" \
        --arg label  "$label" \
        --arg ttl    "$ttl" \
        --argjson claimed_at "$n" \
        --arg claimed_h "$(date -Is -d "@$n")" \
        --argjson expires_at "$exp" \
        --arg expires_h "$(date -Is -d "@$exp")" \
        '{holder:$holder, label:$label, ttl:$ttl,
          claimed_at:$claimed_at, claimed_at_h:$claimed_h,
          expires_at:$expires_at, expires_at_h:$expires_h}' > "$LOCK"
}

# 0 = an exclusive lease file exists and has passed its expiry
excl_expired() {
    [ -f "$LOCK" ] || return 1
    local e; e="$(lock_expiry)"
    [ -n "$e" ] || return 1          # no expiry info: never auto-expires
    [ "$(now)" -ge "$e" ]
}
# Drop an expired exclusive lease.  Caller should hold the state lock.
excl_reap() {
    if excl_expired; then
        warn "exclusive lease '$(lock_field label)' expired at $(lock_field expires_at_h) — treating as free"
        rm -f "$LOCK"; cancel_timer
    fi
}
# 0 = a live (non-expired) exclusive lease is held.  Reaps as a side effect.
excl_live() { excl_reap; [ -f "$LOCK" ]; }

# ===================== state: shared suppressor table =====================
#
# { "version": 2,
#   "suppressors": { LABEL: { vram_mb, holder, ttl, state,
#                             claimed_at, claimed_at_h,
#                             expires_at, expires_at_h } } }
shared_init() {
    [ -s "$SHARED" ] || printf '{"version":2,"suppressors":{}}\n' > "$SHARED"
    jq -e '.suppressors' "$SHARED" >/dev/null 2>&1 || \
        printf '{"version":2,"suppressors":{}}\n' > "$SHARED"
}
shared_write() {                     # stdin = new json
    local tmp; tmp="$(mktemp "${SHARED}.XXXXXX")"
    cat > "$tmp" && mv "$tmp" "$SHARED" || { rm -f "$tmp"; return 1; }
}
# Prune expired suppressors and cancel their timers.  Caller holds state lock.
shared_reap() {
    shared_init
    local n dead; n="$(now)"
    dead="$(jq -r --argjson now "$n" \
        '[.suppressors|to_entries[]|select((.value.expires_at//0)<=$now)|.key]|join(" ")' "$SHARED")"
    [ -n "$dead" ] || return 0
    jq --argjson now "$n" \
        '.suppressors|=with_entries(select((.value.expires_at//0)>$now))' "$SHARED" | shared_write
    local l
    for l in $dead; do
        warn "suppressor '$l' expired — reaped (its holder crashed or overran its ttl)"
        cancel_sup_timer "$l"
    done
}
shared_sum()   { shared_init; jq -r '[.suppressors[].vram_mb]|add // 0' "$SHARED"; }
shared_count() { shared_init; jq -r '.suppressors|length' "$SHARED"; }
shared_labels(){ shared_init; jq -r '.suppressors|keys[]' "$SHARED"; }
sup_field()    { shared_init; jq -r --arg l "$1" '.suppressors[$l].'"$2"' // empty' "$SHARED"; }
sup_exists()   { shared_init; jq -e --arg l "$1" '.suppressors|has($l)' "$SHARED" >/dev/null 2>&1; }

sup_put() {                          # label vram ttl state
    local label="$1" vram="$2" ttl="$3" state="$4" n exp
    n="$(now)"; exp=$(( n + $(ttl_seconds "$ttl") ))
    shared_init
    jq --arg l "$label" \
       --argjson v "$vram" \
       --arg holder "$(whoami)@$(hostname)" \
       --arg ttl "$ttl" --arg state "$state" \
       --argjson ca "$n" --arg cah "$(date -Is -d "@$n")" \
       --argjson ea "$exp" --arg eah "$(date -Is -d "@$exp")" \
       '.suppressors[$l] = {vram_mb:$v, holder:$holder, ttl:$ttl, state:$state,
                            claimed_at:$ca, claimed_at_h:$cah,
                            expires_at:$ea, expires_at_h:$eah}' "$SHARED" | shared_write
}
sup_set_state() {
    shared_init
    jq --arg l "$1" --arg s "$2" \
       'if (.suppressors|has($l)) then .suppressors[$l].state=$s else . end' "$SHARED" | shared_write
}
sup_del() {
    shared_init
    jq --arg l "$1" 'del(.suppressors[$l])' "$SHARED" | shared_write
}

# ---- state mutation lock (serialises admission decisions) ----
state_lock()   { exec 8>"$STATELOCK"; flock 8; }
# NB: the redirections must be scoped to a group.  `exec 8>&- 2>/dev/null` would
# apply the 2>/dev/null to the *shell* permanently (exec with no command sets
# the current shell's redirections), silently swallowing every later log/die.
state_unlock() { { flock -u 8; exec 8>&-; } 2>/dev/null; }

# ---- safety timers (systemd --user transient) ----
# GPU_LEASE_NO_TIMER=1 skips arming entirely (test harness; no systemd there).
sup_unit() { printf '%s-%s' "$SUP_TIMER_PREFIX" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '_')"; }

arm_timer() {
    local ttl="$1"
    [ "${GPU_LEASE_NO_TIMER:-0}" = 1 ] && return 0
    systemctl --user stop "${TIMER_UNIT}.timer" 2>/dev/null || true
    systemctl --user reset-failed "${TIMER_UNIT}.timer" "${TIMER_UNIT}.service" 2>/dev/null || true
    systemd-run --user --on-active="$ttl" --unit="$TIMER_UNIT" \
        --description="gpu-lease safety auto-release" \
        "$SELF" release --expired >/dev/null 2>&1 \
        || warn "could not arm safety timer (lease still granted; release manually)"
}
cancel_timer() {
    [ "${GPU_LEASE_NO_TIMER:-0}" = 1 ] && return 0
    systemctl --user stop "${TIMER_UNIT}.timer" 2>/dev/null || true
    systemctl --user reset-failed "${TIMER_UNIT}.timer" "${TIMER_UNIT}.service" 2>/dev/null || true
}
timer_left() {
    systemctl --user list-timers "${TIMER_UNIT}.timer" --no-pager 2>/dev/null \
        | awk 'NR==2{print $4, $5}'
}
arm_sup_timer() {
    local label="$1" ttl="$2" unit; unit="$(sup_unit "$label")"
    [ "${GPU_LEASE_NO_TIMER:-0}" = 1 ] && return 0
    systemctl --user stop "${unit}.timer" 2>/dev/null || true
    systemctl --user reset-failed "${unit}.timer" "${unit}.service" 2>/dev/null || true
    systemd-run --user --on-active="$ttl" --unit="$unit" \
        --description="gpu-lease safety auto-unsuppress ($label)" \
        "$SELF" unsuppress "$label" --expired >/dev/null 2>&1 \
        || warn "could not arm safety timer for suppressor '$label' (still granted; unsuppress manually)"
}
cancel_sup_timer() {
    local unit; unit="$(sup_unit "$1")"
    [ "${GPU_LEASE_NO_TIMER:-0}" = 1 ] && return 0
    systemctl --user stop "${unit}.timer" 2>/dev/null || true
    systemctl --user reset-failed "${unit}.timer" "${unit}.service" 2>/dev/null || true
}

# ---- voxtral lifecycle, factored so claim and suppress share it ----
# $1 = force (0/1), $2 = wait (0/1).  Applies the idleness gate then stops
# voxtral and waits for its VRAM to actually drop.
voxtral_down() {
    local force="$1" wait="$2"
    while :; do
        local r; r="$(requests_running)"
        if [ "$r" = 0 ]; then break; fi
        if [ "$force" -eq 1 ]; then warn "$r request(s) in flight; --force overriding"; break; fi
        if [ "$wait" -eq 1 ]; then log "$r ASR request(s) in flight; waiting for idle..."; sleep 5; continue; fi
        return 2
    done
    if [ "$(voxtral_active)" = "active" ]; then
        log "stopping voxtral.service..."
        voxtral_stop || return 3
    fi
    local waited=0
    while vllm_on_gpu; do
        [ "$waited" -ge "$VRAM_FREE_TIMEOUT" ] && return 4
        sleep 2; waited=$(( waited + 2 ))
    done
    log "voxtral VRAM released (${waited}s); free: $(gpu_mem_line)"
    return 0
}
# Start voxtral and wait for /health=200.  Returns non-zero on failure.
voxtral_up() {
    log "starting voxtral.service..."
    voxtral_start || warn "voxtral start returned non-zero"
    local waited=0 code
    while :; do
        code="$(health_code)"
        [ "$code" = 200 ] && break
        if [ "$waited" -ge "$HEALTH_TIMEOUT" ]; then
            warn "voxtral did NOT come back healthy after ${HEALTH_TIMEOUT}s (last /health=$code)"
            return 1
        fi
        # heartbeat every ~15s so a long `ssh … release` keeps its stream
        # alive (voxtral load-to-healthy is ~120-140s cache-cold off /mnt/models)
        [ $(( waited % 15 )) -eq 0 ] && [ "$waited" -gt 0 ] && \
            log "waiting for voxtral /health (=$code, ${waited}s elapsed)..."
        sleep 3; waited=$(( waited + 3 ))
    done
    log "ASR healthy again (/health=200 after ${waited}s)"
    return 0
}

# ---- commands ----
cmd_status() {
    local cap; cap="$(capacity_mb)"
    echo "== gpu-lease status =="
    if [ -f "$LOCK" ]; then
        local exp state; exp="$(lock_expiry)"; state="HELD"
        if excl_expired; then state="EXPIRED (treated as free; reaped on next claim/suppress)"; fi
        echo "lease:   $state by '$(lock_field label)'  (holder $(lock_field holder), age $(lock_age))"
        echo "         claimed $(lock_field claimed_at_h)  ttl $(lock_field ttl)  expires $(lock_field expires_at_h)"
        echo "timer:   $(timer_left)   (backstop only — expires_at above is authoritative)"
    else
        echo "lease:   free"
    fi
    shared_init
    local n sum; n="$(shared_count)"; sum="$(shared_sum)"
    if [ "$n" -gt 0 ]; then
        echo "shared:  $n suppressor(s), ${sum} MiB declared"
        local l
        for l in $(shared_labels); do
            local ea ex=""; ea="$(sup_field "$l" expires_at)"
            case "$ea" in ''|*[!0-9]*) ;; *) [ "$(now)" -ge "$ea" ] && ex="  EXPIRED" ;; esac
            printf "         %-22s %6s MiB  state=%-7s expires %s%s\n" \
                "$l" "$(sup_field "$l" vram_mb)" "$(sup_field "$l" state)" \
                "$(sup_field "$l" expires_at_h)" "$ex"
        done
    else
        echo "shared:  none"
    fi
    echo "budget:  capacity ${cap} MiB - reserve ${RESERVE_MB} MiB = $(( cap - RESERVE_MB )) MiB for suppressors; $(( cap - RESERVE_MB - sum )) MiB free to grant"
    local rr; rr="$(requests_running)"
    echo "voxtral: $(voxtral_active)   /health=$(health_code)   requests_running=$rr"
    echo "ollama ps:"
    ollama ps 2>&1 | sed 's/^/         /'
    echo "gpu mem: $(gpu_mem_line)"
    echo "gpu procs:"
    gpu_apps | sed 's/^/         /'
}

cmd_claim() {
    local wait=0 force=0 ttl="$DEFAULT_TTL" label=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --wait)   wait=1 ;;
            --force)  force=1 ;;
            --ttl)    ttl="$2"; shift ;;
            --ttl=*)  ttl="${1#--ttl=}" ;;
            -*)       die "unknown flag: $1" ;;
            *)        label="$1" ;;
        esac
        shift
    done
    [ -n "$label" ] || die "usage: gpu-lease claim [--wait] [--force] [--ttl DUR] LABEL"

  # The gates and the lock write are one retry loop: voxtral_down can take a
  # minute, and a suppressor admitted during that window must not be trampled.
  # The final check below re-tests both gates while holding the state lock, and
  # loops (or fails) if we lost the race.
  while :; do

    # 1. existing exclusive lease (expiry-aware: an expired lease is free)
    while :; do
        state_lock; excl_reap; state_unlock
        [ -f "$LOCK" ] || break
        if [ "$force" -eq 1 ]; then
            warn "taking over lease held by '$(lock_field label)' (age $(lock_age)) — --force"
            break
        fi
        if [ "$wait" -eq 1 ]; then
            log "lease held by '$(lock_field label)' (age $(lock_age)); waiting for release..."
            sleep 5; continue
        fi
        echo "[gpu-lease] ERROR: GPU lease already held:" >&2
        cat "$LOCK" >&2
        exit 1
    done

    # 1b. shared suppressors — exclusive mode needs the whole card, so it may
    #     not land on top of a shared set.
    while :; do
        state_lock; shared_reap; local n; n="$(shared_count)"; state_unlock
        [ "$n" -eq 0 ] && break
        if [ "$force" -eq 1 ]; then
            warn "$n suppressor(s) active ($(shared_labels | tr '\n' ' ')); --force overriding — the shared tenants may OOM"
            break
        fi
        if [ "$wait" -eq 1 ]; then
            log "$n suppressor(s) active ($(shared_labels | tr '\n' ' ')); waiting for them to finish..."
            sleep 5; continue
        fi
        die "refusing to claim: $n shared suppressor(s) active ($(shared_labels | tr '\n' ' ')) (use --wait to queue, --force to override)"
    done

    # 2./3. idleness gate, stop voxtral, wait for VRAM to actually drop
    log "claiming GPU for '$label' (ttl $ttl)"
    voxtral_down "$force" "$wait"; local rc=$?
    case "$rc" in
        0) ;;
        2) die "refusing to claim: $(requests_running) ASR request(s) in flight (use --wait to queue, --force to override)" ;;
        3) die "failed to stop voxtral.service" ;;
        4) die "voxtral VRAM still held after ${VRAM_FREE_TIMEOUT}s" ;;
    esac

    # 4. atomically re-check both gates, then write the lock
    state_lock
    excl_reap; shared_reap
    local lost=""
    if [ "$force" -eq 0 ]; then
        [ -f "$LOCK" ] && lost="lease taken by '$(lock_field label)'"
        [ -z "$lost" ] && [ "$(shared_count)" -ne 0 ] && \
            lost="suppressor(s) arrived ($(shared_labels | tr '\n' ' '))"
    fi
    if [ -n "$lost" ]; then
        state_unlock
        [ "$wait" -eq 1 ] || die "lost the race for the GPU while voxtral was stopping: $lost (use --wait to queue)"
        warn "lost the race for the GPU while voxtral was stopping: $lost — retrying"
        sleep 5; continue
    fi
    write_lock "$label" "$ttl"
    state_unlock

    # 5. arm safety timer
    arm_timer "$ttl"
    break
  done

    # 6. done — GPU is free for the new tenant
    log "GPU leased to '$label'. Safety auto-release in $ttl (or run: gpu-lease release)."
    echo "$LOCK"
}

cmd_suppress() {
    local wait=0 force=0 ttl="$DEFAULT_SUP_TTL" label="" vram="" timeout=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --wait)     wait=1 ;;
            --force)    force=1 ;;
            --ttl)      ttl="$2"; shift ;;
            --ttl=*)    ttl="${1#--ttl=}" ;;
            --vram)     vram="$2"; shift ;;
            --vram=*)   vram="${1#--vram=}" ;;
            --timeout)  timeout="$2"; shift ;;
            --timeout=*) timeout="${1#--timeout=}" ;;
            -*)         die "unknown flag: $1" ;;
            *)          label="$1" ;;
        esac
        shift
    done
    [ -n "$label" ] || die "usage: gpu-lease suppress [--wait] [--force] [--ttl DUR] [--timeout S] --vram MiB LABEL"
    case "$vram" in ''|*[!0-9]*) die "--vram MiB is required and must be an integer (MiB)" ;; esac

    local cap budget started; cap="$(capacity_mb)"; budget=$(( cap - RESERVE_MB ))
    [ "$vram" -le "$budget" ] || die "--vram $vram MiB exceeds the whole shared budget ($budget MiB = capacity $cap - reserve $RESERVE_MB); use 'claim' for a whole-card tenant"
    started="$(now)"

    local first=0
    while :; do
        state_lock
        excl_reap
        shared_reap
        local held=0 sum other ok=0
        [ -f "$LOCK" ] && held=1
        sum="$(shared_sum)"
        # a re-suppress of the same label refreshes it rather than double-counting
        other="$sum"
        if sup_exists "$label"; then other=$(( sum - $(sup_field "$label" vram_mb) )); fi
        if [ "$held" -eq 1 ]; then
            :
        elif [ $(( other + vram )) -le "$budget" ]; then
            ok=1
        fi
        if [ "$ok" -eq 1 ]; then
            [ "$(shared_count)" -eq 0 ] && first=1
            sup_put "$label" "$vram" "$ttl" pending
            arm_sup_timer "$label" "$ttl"
            state_unlock
            break
        fi
        local why
        if [ "$held" -eq 1 ]; then
            why="exclusive lease held by '$(lock_field label)'"
        else
            why="VRAM budget: $other MiB in use + $vram MiB requested > $budget MiB available (capacity $cap - reserve $RESERVE_MB)"
        fi
        state_unlock
        if [ "$wait" -eq 1 ]; then
            if [ -n "$timeout" ] && [ $(( $(now) - started )) -ge "$timeout" ]; then
                die "timed out after ${timeout}s waiting to suppress '$label': $why"
            fi
            log "cannot suppress yet ($why); waiting..."
            sleep 5; continue
        fi
        die "refusing to suppress '$label': $why (use --wait to queue)"
    done

    log "suppressor '$label' admitted (${vram} MiB, ttl $ttl); shared total now $(shared_sum)/$budget MiB"

    # Stop voxtral only on the 0 -> 1 refcount transition.  Done outside the
    # state lock (the idleness gate can wait minutes) — the entry is already
    # accounted, so the budget stays correct meanwhile; roll it back on failure.
    if [ "$first" -eq 1 ]; then
        log "first suppressor — freeing voxtral's VRAM"
        voxtral_down "$force" "$wait"; local rc=$?
        if [ "$rc" -ne 0 ]; then
            state_lock; sup_del "$label"; state_unlock; cancel_sup_timer "$label"
            case "$rc" in
                2) die "refusing to suppress: $(requests_running) ASR request(s) in flight (use --wait to queue, --force to override)" ;;
                3) die "failed to stop voxtral.service" ;;
                4) die "voxtral VRAM still held after ${VRAM_FREE_TIMEOUT}s" ;;
                *) die "could not free voxtral VRAM (rc=$rc)" ;;
            esac
        fi
    else
        log "$(shared_count) suppressor(s) already active — voxtral already down, no bounce"
    fi

    state_lock; sup_set_state "$label" active; state_unlock
    log "GPU shared with '$label'. Safety auto-unsuppress in $ttl (or run: gpu-lease unsuppress $label)."
    echo "$SHARED"
}

cmd_unsuppress() {
    local label="" expired=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --expired) expired=1 ;;
            -*)        die "unknown flag: $1" ;;
            *)         label="$1" ;;
        esac
        shift
    done
    [ -n "$label" ] || die "usage: gpu-lease unsuppress [--expired] LABEL"

    # serialise against release / other unsuppress: only one voxtral transition
    exec 9>"$RELLOCK"
    flock 9

    state_lock
    shared_init
    if ! sup_exists "$label"; then
        state_unlock
        warn "no suppressor '$label' (already released)"
    else
        # The safety timer is a BACKSTOP, not the authority: systemd re-bases
        # monotonic timers on any `systemctl --user daemon-reload`, so it can
        # fire early.  Re-check the recorded expiry and re-arm for the
        # remainder if this label is not actually expired yet.
        if [ "$expired" -eq 1 ]; then
            local ea rem; ea="$(sup_field "$label" expires_at)"
            rem=$(( ea - $(now) ))
            if [ "$rem" -gt 5 ]; then
                state_unlock
                warn "safety timer for '$label' fired early (systemd re-based it?); ${rem}s left on its ttl — re-arming, not releasing"
                arm_sup_timer "$label" "${rem}s"
                exit 0
            fi
            log "SAFETY TIMER EXPIRED — dropping suppressor '$label'"
        else
            log "dropping suppressor '$label' ($(sup_field "$label" vram_mb) MiB)"
        fi
        sup_del "$label"
        state_unlock
        cancel_sup_timer "$label"
    fi

    state_lock; shared_reap; local n; n="$(shared_count)"; local held=0; excl_reap; [ -f "$LOCK" ] && held=1; state_unlock

    if [ "$n" -gt 0 ]; then
        log "$n suppressor(s) still active ($(shared_labels | tr '\n' ' ')) — leaving voxtral down"
        exit 0
    fi
    if [ "$held" -eq 1 ]; then
        log "exclusive lease '$(lock_field label)' still held — leaving voxtral down"
        exit 0
    fi
    if [ "$(voxtral_active)" = "active" ] && [ "$(health_code)" = 200 ]; then
        log "no suppressors left; voxtral already healthy"
        exit 0
    fi
    log "last suppressor released — restoring ASR"
    voxtral_up || die "voxtral did NOT come back healthy — ASR MAY BE DOWN, investigate now"
}

cmd_release() {
    local expired=0
    [ "${1:-}" = "--expired" ] && expired=1

    # serialize concurrent releases (manual EXIT trap vs safety timer)
    exec 9>"$RELLOCK"
    flock 9

    if [ ! -f "$LOCK" ]; then
        warn "no lease held (already released)"
        # Defensive: if ASR is somehow down with no lease, restore it — but NOT
        # while shared tenants are using the card.
        state_lock; shared_reap; local ns; ns="$(shared_count)"; state_unlock
        if [ "$ns" -gt 0 ]; then
            log "$ns suppressor(s) active ($(shared_labels | tr '\n' ' ')) — leaving voxtral down"
            cancel_timer
            exit 0
        fi
        if [ "$(voxtral_active)" != "active" ]; then
            warn "voxtral is not active though no lease is held — restarting it"
        else
            cancel_timer
            exit 0
        fi
    else
        local label; label="$(lock_field label)"
        # Backstop semantics, as for unsuppress: a timer that fires while the
        # recorded expires_at is still in the future was re-based by systemd.
        # Legacy locks with no derivable expiry skip this check and release.
        if [ "$expired" -eq 1 ]; then
            local ea rem; ea="$(lock_expiry)"
            if [ -n "$ea" ]; then
                rem=$(( ea - $(now) ))
                if [ "$rem" -gt 5 ]; then
                    warn "safety timer fired early (systemd re-based it?); ${rem}s left on lease '$label' — re-arming, not releasing"
                    arm_timer "${rem}s"
                    exit 0
                fi
            else
                warn "lease '$label' has no usable expires_at (legacy lock) — honouring the timer and releasing"
            fi
            log "SAFETY TIMER EXPIRED — releasing lease '$label'"
        else
            log "releasing lease '$label'"
        fi
        log "unloading $QWEN_MODEL..."
        ollama stop "$QWEN_MODEL" 2>/dev/null || true
    fi

    rm -f "$LOCK"
    cancel_timer

    # Restart voxtral only if nothing else is using the card.
    state_lock; shared_reap; local n; n="$(shared_count)"; state_unlock
    if [ "$n" -gt 0 ]; then
        log "lease released, but $n suppressor(s) still active ($(shared_labels | tr '\n' ' ')) — leaving voxtral down"
        exit 0
    fi
    voxtral_up || die "voxtral did NOT come back healthy after ${HEALTH_TIMEOUT}s — ASR MAY BE DOWN, investigate now"
    log "lease released"
}

usage() {
    cat >&2 <<'EOF'
gpu-lease — GPU arbitration on pony

  gpu-lease status
      One-screen summary: exclusive lease, shared suppressors and the VRAM
      budget, voxtral health, vLLM requests, ollama ps, nvidia-smi memory.

  EXCLUSIVE — "I need the whole card" (ollama qwen3.6:27b)

  gpu-lease claim [--wait] [--force] [--ttl DUR] LABEL
      Refuses if a lease is held, if any shared suppressor is active, or if ASR
      is busy; --wait queues, --force overrides. Stops voxtral, waits for VRAM
      to drop, writes the lock, arms a safety auto-release timer (default 2h).
      DUR: systemd time span, e.g. 2h, 90min, 30s.

  gpu-lease release [--expired]
      Unload qwen, drop the lock, cancel the timer, and restart voxtral —
      unless shared suppressors are still active, in which case ASR stays down
      for them. Idempotent. --expired is used by the safety timer.

  SHARED — "I need N MiB alongside others" (caption pipeline, SAM 2 tracking)

  gpu-lease suppress [--wait] [--force] [--ttl DUR] [--timeout S] --vram MiB LABEL
      Refcounted, VRAM-gated. Granted iff no exclusive lease is held and
      sum(suppressors) + MiB + reserve <= capacity. voxtral is stopped only on
      the 0->1 transition, so a second tenant costs no ASR bounce. Re-running
      with the same LABEL refreshes that entry (no double counting).

  gpu-lease unsuppress [--expired] LABEL
      Drop one suppressor. Restarts voxtral only when the refcount reaches 0
      and no exclusive lease is held. Idempotent.

Environment: GPU_LEASE_RESERVE_MB (default 5120), GPU_LEASE_CAPACITY_MB,
GPU_LEASE_HEALTH_URL, GPU_LEASE_METRICS_URL, GPU_LEASE_NO_TIMER,
GPU_LEASE_BIN_OVERRIDE (the last three for tests only).
EOF
    exit 2
}

main() {
    local cmd="${1:-}"; shift || true
    case "$cmd" in
        status)     cmd_status "$@" ;;
        claim)      cmd_claim  "$@" ;;
        release)    cmd_release "$@" ;;
        suppress)   cmd_suppress "$@" ;;
        unsuppress) cmd_unsuppress "$@" ;;
        ""|-h|--help|help) usage ;;
        *) die "unknown command: $cmd (try: status | claim | release | suppress | unsuppress)" ;;
    esac
}
main "$@"
